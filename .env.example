# Set true only after the LiveKit project and Chusky brain bridge are ready.
LIVEKIT_ENABLED=false

# LiveKit Cloud or self-hosted LiveKit project credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch keeps job routing deterministic. Do not use automatic
# dispatch for production phone calls.
LIVEKIT_AGENT_NAME=chusky-voice
LIVEKIT_DEPLOYMENT=production

# Chusky remains the authoritative brain. The worker sends only bounded,
# signed, call-scoped requests to this endpoint.
LIVEKIT_BRAIN_URL=https://chusky.up.railway.app/internal/livekit/brain
LIVEKIT_BRAIN_SECRET=

# LiveKit Inference model descriptors. Pin these per deployment after staging.
LIVEKIT_MODEL_STT=deepgram/nova-3
LIVEKIT_MODEL_LLM=google/gemma-4-31b-it
LIVEKIT_MODEL_TTS=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-b8aa-f8ba9e84c8bc

# Operational limits. The worker fails closed when these are invalid.
LIVEKIT_BRAIN_TIMEOUT_MS=12000
LIVEKIT_TURN_MIN_DELAY_MS=300
LIVEKIT_TURN_MAX_DELAY_MS=2000
LIVEKIT_INTERRUPTION_MIN_DURATION_MS=250
# Keep false unless staging measurements justify speculative audio generation.
LIVEKIT_PREEMPTIVE_TTS=false
LIVEKIT_MAX_TURNS=120
LIVEKIT_MAX_TOOL_CALLS=24
# Keep LiveKit traces off by default because traces can contain model context.
LIVEKIT_RECORD_TRACES=false
LIVEKIT_LOG_LEVEL=info
